# Ollama Cloud Configuration Example
# Set these environment variables to enable cloud model support

# Local Ollama API URL
OLLAMA_API_URL=http://localhost:11434

# Enable cloud fallback when local models are slow
KOOG_ENABLE_CLOUD_FALLBACK=true

# Cloud fallback threshold in milliseconds (switch to cloud if response takes longer)
KOOG_CLOUD_FALLBACK_THRESHOLD=5000

# Preferred cloud provider
KOOG_PREFERRED_CLOUD_PROVIDER=generic

# Generic Ollama Cloud Provider
KOOG_CLOUD_GENERIC_URL=https://api.ollama.com
KOOG_CLOUD_GENERIC_API_KEY=your-api-key-here
KOOG_CLOUD_GENERIC_REGION=us-west-2

# Ollama Official Cloud
KOOG_CLOUD_OLLAMA_CLOUD_URL=https://cloud.ollama.ai
KOOG_CLOUD_OLLAMA_CLOUD_API_KEY=your-ollama-cloud-key

# Hugging Face Inference API
KOOG_CLOUD_HUGGING_FACE_URL=https://api-inference.huggingface.co
KOOG_CLOUD_HUGGING_FACE_API_KEY=your-hf-token

# Replicate API
KOOG_CLOUD_REPLICATE_URL=https://api.replicate.com
KOOG_CLOUD_REPLICATE_API_KEY=your-replicate-token

# Anyscale API
KOOG_CLOUD_ANYSCALE_URL=https://api.anyscale.com
KOOG_CLOUD_ANYSCALE_API_KEY=your-anyscale-token

# Other configuration options
KOOG_MAX_CONTEXT_LENGTH=4096
KOOG_SESSION_TIMEOUT_MINUTES=30
KOOG_PROJECT_PATH=.
