title Cluster-Based Discovery Architecture

# Phase 1: Architecture Detection
participant "File Scanner" as Scanner
participant "Architecture Detector" as Detector
participant "Detector Configurator" as Config

Scanner->Detector: Scan project files
activate Detector
Detector->Detector: Analyze patterns\n(Kotlin classes, package structure)
Detector->Detector: Detect frameworks\n(Spring, Ktor, etc.)
Detector-->Scanner: architecture_signature (confidence score)
deactivate Detector

Scanner->Config: Configure for detected architecture
activate Config
Config->Config: Generate entry point patterns\n(based on framework)
Config->Config: Generate cluster boundaries
Config-->Scanner: Entry patterns, cluster boundaries
deactivate Config

# Phase 2: Cluster Detection
participant "Cluster Detector" as Cluster

Scanner->Cluster: Detect clusters
activate Cluster
Cluster->Cluster: Try build module detection
Cluster->Cluster: Parse settings.gradle.kts
Cluster->Cluster: Extract module declarations

alt Build modules found
    Cluster->Cluster: Use build modules as clusters
    note right of Cluster: Gradle modules:\n- i2vision-discover\n- i2vision-instant\n- i2vision-mcp\n- etc.
    Cluster-->Scanner: Cluster list (from build)
else No build modules
    Cluster->Cluster: Fallback to directory structure
    Cluster->Cluster: Scan source directories
    Cluster->Cluster: Group by package structure
    Cluster->Cluster: Create clusters from directories
    Cluster-->Scanner: Cluster list (from directories)
end
deactivate Cluster

# Phase 3: Call Graph Analysis
participant "Call Graph Analyzer" as CallGraph

Scanner->CallGraph: Scan with architecture patterns
activate CallGraph
CallGraph->CallGraph: Find entry points\n(files matching patterns)
CallGraph->CallGraph: Build call hierarchy\n(analyze dependencies)
CallGraph-->Scanner: call-graph.json\n(entry points, dependencies)
deactivate CallGraph

# Phase 4: Per-Cluster Discovery
participant "DiscoveryPipeline" as Pipeline
participant "Semantic Cache" as Cache

loop for each cluster
    Scanner->Pipeline: discoverFromFilesInCluster(\nclusterId, files, entryPoints)
    activate Pipeline

    Pipeline->Pipeline: Extract symbols from files
    Pipeline->Pipeline: Discover flows\n(using entry points)
    Pipeline->Pipeline: Discover logic\n(business rules, entities)
    Pipeline->Pipeline: Discover structure\n(components, dependencies)
    Pipeline->Pipeline: Discover vision\n(requirements, constraints)

    Pipeline->Cache: Write artifacts (cluster-locked)
    activate Cache
    Cache->Cache: Write entities.yaml
    Cache->Cache: Write business-rules.yaml
    Cache->Cache: Write components.yaml
    Cache->Cache: Write flows.yaml
    Cache->Cache: Write *.sd, *.feature files
    Cache-->Pipeline: Success
    deactivate Cache

    Pipeline-->Scanner: PipelineResult\n(refs, coverage stats)
    deactivate Pipeline
end

Scanner->Scanner: Aggregate results\nacross all clusters

Scanner-->Scanner: Summary:\nClusters processed\nItems discovered
deactivate Scanner

# Final Structure
note over Scanner: Semantic Cache:\n  {cluster-id}/vision/\n  {cluster-id}/structure/\n  {cluster-id}/logic/\n  {cluster-id}/flow/\n  {cluster-id}/code/\n  contracts/registry.yaml\n  links.yaml

