data class ModelDownloadState(
        modifier = Modifier
            .fillMaxWidth()
            .padding(16.dp),
        elevation = 8.dp
    ) {
        Column(
            modifier = Modifier.padding(16.dp)
        ) {
            Row(
                modifier = Modifier.fillMaxWidth(),
                horizontalArrangement = Arrangement.SpaceBetween,
                verticalAlignment = Alignment.CenterVertically
            ) {
                Text(
                    text = "Model Library",
                    style = MaterialTheme.typography.h6
                )
                
                IconButton(
                    onClick = onDismiss
                ) {
                    Icon(
                        imageVector = Icons.Default.KeyboardArrowUp,
                        contentDescription = "Close"
                    )
                }
            }
            
            Divider(modifier = Modifier.padding(vertical = 8.dp))
            
            LazyColumn(
                modifier = Modifier.fillMaxWidth().height(400.dp),
                verticalArrangement = Arrangement.spacedBy(8.dp)
            ) {
                items(models) { model ->
                    LibraryModelItem(
                        model = model,
                        downloadState = downloadStates.find { it.modelName == model.name },
                        onDownload = { onDownloadModel(model.name) },
                        onPull = { onPullModel(model.name) }
                    )
                }
            }
        }
    }
}


@Composable
private fun LibraryModelItem(
    model: LibraryModel,
    downloadState: ModelDownloadState?,
    onDownload: () -> Unit,
    onPull: () -> Unit
) {
    Card(
        modifier = Modifier
            .fillMaxWidth()
            .background(if (downloadState != null) Color(0xFFFFF3E0) else MaterialTheme.colors.surface),
        elevation = 2.dp
    ) {
        Row(
            modifier = Modifier
                .fillMaxWidth()
                .padding(12.dp)
                .clickable { onDownload() },
            verticalAlignment = Alignment.CenterVertically
        ) {
            // Model Info
            Column(modifier = Modifier.weight(1f)) {
                Text(
                    text = model.name,
                    style = MaterialTheme.typography.body2,
                    color = MaterialTheme.colors.onSurface
                )
                Text(
                    text = model.description,
                    style = MaterialTheme.typography.caption,
                    color = MaterialTheme.colors.onSurface.copy(alpha = 0.7f),
                    maxLines = 2
                )
                
                Spacer(Modifier.height(4.dp))
                
                Row(
                    horizontalArrangement = Arrangement.spacedBy(8.dp)
                ) {
                    // Tags
                    model.tags.take(3).forEach { tag ->
                        Text(
                            text = "• $tag",
                            style = MaterialTheme.typography.caption,
                            color = MaterialTheme.colors.primary,
                            modifier = Modifier
                                .background(Color(0xFFE3F2FD).copy(alpha = 0.2f))
                                .padding(horizontal = 4.dp, vertical = 2.dp)
                        )
                    }
                    
                    // Size info
                    Text(
                        text = "📊 ${model.size}",
                        style = MaterialTheme.typography.caption,
                        color = MaterialTheme.colors.onSurface.copy(alpha = 0.6f)
                    )
                }
            }
            
            // Actions
            Row(
                horizontalArrangement = Arrangement.spacedBy(8.dp),
                verticalAlignment = Alignment.CenterVertically
            ) {
                if (downloadState != null) {
                    when (downloadState.status) {
                        "downloading" -> {
                            Column(
                                horizontalAlignment = Alignment.CenterHorizontally,
                                verticalArrangement = Arrangement.Center
                            ) {
                                CircularProgressIndicator(
                                    progress = downloadState.progress,
                                    modifier = Modifier.size(24.dp),
                                    strokeWidth = 2.dp
                                )
                                Text(
                                    text = "${(downloadState.progress * 100).toInt()}%",
                                    style = MaterialTheme.typography.caption,
                                    color = MaterialTheme.colors.primary
                                )
                            }
                        }
                        "completed" -> {
                            Text(
                                text = "✅ Downloaded",
                                style = MaterialTheme.typography.caption,
                                color = Color(0xFF4CAF50)
                            )
                        }
                        "error" -> {
                            Text(
                                text = "❌ ${downloadState.error ?: "Error"}",
                                style = MaterialTheme.typography.caption,
                                color = Color(0xFFF44336)
                            )
                        }
                    }
                } else {
                    TextButton(
                        onClick = onPull,
                        modifier = Modifier.height(32.dp).defaultMinSize(minWidth = 50.dp)
                    ) {
                        Text("Pull", style = MaterialTheme.typography.caption)
                    }
                }
            }
        }
    }
}

