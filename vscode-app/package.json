{
    "name": "i2-vision-vscode",
    "displayName": "i2-Vision",
    "description": "i2-Vision VSCode Extension with Tree View, CLI Integration, and Agent Support",
    "version": "1.0.0",
    "publisher": "i2vision",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "*"
    ],
    "main": "./out/extension.js",
    "contributes": {
        "viewsContainers": {
            "activitybar": [
                {
                    "id": "i2vision-explorer",
                    "title": "i2-Vision Explorer",
                    "icon": "resources/i2vision-icon.svg"
                }
            ]
        },
        "views": {
            "i2vision-explorer": [
                {
                    "id": "i2visionTreeView",
                    "name": "i2-Vision Projects",
                    "icon": "resources/i2vision-icon.svg",
                    "contextualTitle": "i2-Vision"
                }
            ]
        },
        "commands": [
            {
                "command": "i2vision.refreshTree",
                "title": "Refresh",
                "icon": {
                    "light": "resources/refresh.svg",
                    "dark": "resources/refresh.svg"
                },
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.openProject",
                "title": "Open Project",
                "category": "i2-Vision",
                "icon": {
                    "light": "resources/open.svg",
                    "dark": "resources/open.svg"
                }
            },
            {
                "command": "i2vision.createProject",
                "title": "Create New Project",
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.init",
                "title": "Initialize VSLFC Structure (i2vision.init)",
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.helloWorld",
                "title": "Hello World",
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.openFile",
                "title": "Open File",
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.showDiscovery",
                "title": "Show Discovery Results",
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.analyzeArchitecture",
                "title": "Analyze Architecture",
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.viewDocumentation",
                "title": "View Documentation",
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.toggleFileSystemScan",
                "title": "Toggle File System Scan",
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.scanWorkspace",
                "title": "Scan Workspace",
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.showFileInfo",
                "title": "Show File Information",
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.openContainingFolder",
                "title": "Open Containing Folder",
                "category": "i2-Vision"
            },
            {
                "command": "i2vision.newCodingAgent",
                "title": "New Coding Agent Tab",
                "category": "i2-Vision Agents",
                "icon": {
                    "light": "resources/robot.svg",
                    "dark": "resources/robot.svg"
                }
            },
            {
                "command": "i2vision.newVisionAgent",
                "title": "New Vision Agent Tab",
                "category": "i2-Vision Agents"
            },
            {
                "command": "i2vision.newStructureAgent",
                "title": "New Structure Agent Tab",
                "category": "i2-Vision Agents"
            },
            {
                "command": "i2vision.newLogicAgent",
                "title": "New Logic Agent Tab",
                "category": "i2-Vision Agents"
            },
            {
                "command": "i2vision.newFlowAgent",
                "title": "New Flow Agent Tab",
                "category": "i2-Vision Agents"
            },
            {
                "command": "i2vision.debugToolCalls",
                "title": "Debug Tool Calls",
                "category": "i2-Vision Debug"
            },
            {
                "command": "i2vision.verifyTools",
                "title": "Verify Tool Definitions",
                "category": "i2-Vision Debug"
            },
            {
                "command": "i2vision.checkAgentConfig",
                "title": "Check Agent Configuration",
                "category": "i2-Vision Debug"
            },
            {
                "title": "Quick Diagnostic",
                "command": "i2vision.quickDiagnostic",
                "category": "i2-Vision Debug"
            },
            {
                "title": "Reload Agent Config",
                "command": "i2vision.reloadAgentConfig",
                "category": "i2-Vision Debug"
            },
            {
                "command": "i2vision.resumeConversation",
                "title": "Resume Conversation",
                "category": "i2-Vision Agents"
            }
        ],
        "menus": {
            "view/title": [
                {
                    "command": "i2vision.refreshTree",
                    "when": "view == i2visionTreeView",
                    "group": "navigation"
                }
            ],
            "commandPalette": [
                {
                    "command": "i2vision.openFile",
                    "when": "false"
                },
                {
                    "command": "i2vision.showFileInfo",
                    "when": "false"
                },
                {
                    "command": "i2vision.openContainingFolder",
                    "when": "false"
                }
            ]
        },
        "configuration": {
            "title": "i2-Vision",
            "properties": {
                "i2vision.toolCards.showTools": {
                    "type": "string",
                    "default": "all",
                    "enum": [
                        "all",
                        "failed_only",
                        "none"
                    ],
                    "enumDescriptions": [
                        "Show all tool results",
                        "Show only failed tool results",
                        "Hide all tool results"
                    ],
                    "description": "Which tool results to display in agent chat"
                },
                "i2vision.toolCards.defaultMaxLines": {
                    "type": "integer",
                    "default": 20,
                    "minimum": 0,
                    "description": "Default max lines to show per tool result (0 = unlimited)"
                },
                "i2vision.toolCards.defaultMaxChars": {
                    "type": "integer",
                    "default": 3000,
                    "minimum": 0,
                    "description": "Default max characters per tool result (0 = unlimited)"
                },
                "i2vision.toolCards.defaultFoldThreshold": {
                    "type": "integer",
                    "default": 10,
                    "minimum": 0,
                    "description": "Lines before fold toggle appears (0 = always folded)"
                },
                "i2vision.toolCards.defaultFoldDefault": {
                    "type": "string",
                    "default": "collapsed",
                    "enum": [
                        "expanded",
                        "collapsed"
                    ],
                    "description": "Default fold state for tool cards"
                },
                "i2vision.toolCards.defaultFormat": {
                    "type": "string",
                    "default": "raw",
                    "enum": [
                        "raw",
                        "markdown",
                        "tree",
                        "table"
                    ],
                    "enumDescriptions": [
                        "Show raw text output",
                        "Format as markdown",
                        "Format as directory tree",
                        "Format as markdown table"
                    ],
                    "description": "Default output format for tool results"
                },
                "i2vision.toolCards.defaultShowLineNumbers": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show line numbers for code output"
                },
                "i2vision.toolCards.defaultSyntaxHighlight": {
                    "type": "boolean",
                    "default": false,
                    "description": "Enable syntax highlighting for code blocks"
                },
                "i2vision.toolCards.defaultShowArgs": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show tool arguments in the card header"
                },
                "i2vision.toolCards.defaultShowDuration": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show execution time in the card header"
                },
                "i2vision.toolCards.defaultCollapseOnSuccess": {
                    "type": "boolean",
                    "default": true,
                    "description": "Auto-collapse cards for successful tool calls"
                },
                "i2vision.3dLlmUrl": {
                    "type": "string",
                    "default": "http://localhost:9655",
                    "description": "Base URL for 3D LLM (FreeDeepseekAPI) proxy"
                },
                "i2vision.toolCards.perToolConfig": {
                    "type": [
                        "object",
                        "null"
                    ],
                    "default": null,
                    "description": "Per-tool display overrides. Key = tool name, value = partial ToolDisplayOptions object. Example: {\"read_file\": {\"maxLines\": 50, \"syntaxHighlight\": true}}"
                },
                "i2vision.output.showReasoning": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show LLM reasoning headers in output (reasoning:, tool_calls:, etc.)"
                },
                "i2vision.output.autoCollapse": {
                    "type": "integer",
                    "default": 500,
                    "minimum": 0,
                    "description": "Auto-collapse responses longer than N characters (0 = never collapse)"
                },
                "i2vision.output.maxPreviewLines": {
                    "type": "integer",
                    "default": 10,
                    "minimum": 1,
                    "description": "Show N lines in preview mode when collapsed"
                },
                "i2vision.output.theme": {
                    "type": "string",
                    "default": "system",
                    "enum": [
                        "system",
                        "light",
                        "dark",
                        "compact"
                    ],
                    "enumDescriptions": [
                        "Follow VSCode theme",
                        "Light theme",
                        "Dark theme",
                        "Compact mode (minimal spacing)"
                    ],
                    "description": "Output card visual theme"
                },
                "i2vision.output.fontSize": {
                    "type": "string",
                    "default": "medium",
                    "enum": [
                        "small",
                        "medium",
                        "large"
                    ],
                    "description": "Font size for output text"
                },
                "i2vision.output.showTokenCount": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show token usage in output card footer"
                },
                "i2vision.output.showConfidence": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show confidence score in output card footer"
                },
                "i2vision.output.showToolDetails": {
                    "type": "boolean",
                    "default": true,
                    "description": "Show detailed tool call cards with args and results"
                },
                "i2vision.output.codeHighlight": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable syntax highlighting for code blocks"
                }
            }
        }
    },
    "scripts": {
        "compile": "tsc -p ./ && node scripts/copy-resources.js",
        "watch": "tsc -watch -p ./",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js",
        "test:unit": "mocha ./out/test/suite/**/*.js",
    "test:agent": "node ./out/test/runTestAgent.js",
        "package": "vsce package",
        "publish": "vsce publish"
    },
    "devDependencies": {
        "@types/jest": "^30.0.0",
        "@types/js-yaml": "^4.0.9",
        "@types/mocha": "^10.0.10",
        "@types/node": "^20.0.0",
        "@types/vscode": "^1.90.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "@vscode/test-electron": "^2.5.2",
        "@vscode/vsce": "^2.24.0",
        "eslint": "^8.57.0",
        "jest": "^30.4.2",
        "mocha": "^11.7.6",
        "ts-jest": "^29.4.12",
        "typescript": "^5.4.0"
    },
    "dependencies": {
        "glob": "^10.3.0",
        "js-yaml": "^4.1.0"
    }
}
